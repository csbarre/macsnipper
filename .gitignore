# Public repository allowlist. Private QA and local configuration stay untracked.
/*
!/.gitignore
!/README.md
!/mac/
!/tests/
!/assembly/
!/binaries/
!/cpp/
!/dmg/
/assembly/*
!/assembly/*.asm
!/assembly/README.md
!/assembly/annotate.py
!/assembly/test_annotate.py
!/assembly/verify_annotations.py
!/assembly/test_verification.py
/binaries/*
!/binaries/AppxManifest.xml
!/binaries/ScreenSketch.exe
!/binaries/ScreenSketch.winmd
!/binaries/ScreenSketchAppService.dll
!/binaries/ScreenSketchAppService.winmd
!/binaries/SnippingTool.exe
!/binaries/README.md
/cpp/*
!/cpp/*.pseudocode.c
!/cpp/README.md
/dmg/*
!/dmg/SnipForMac.dmg
!/dmg/README.md
/mac/*
!/mac/Sources/
!/mac/Tools/
!/mac/Info.plist
!/mac/README.md
!/mac/build.sh
!/mac/package.sh
/mac/Sources/*
!/mac/Sources/*.swift
/mac/Tools/*
!/mac/Tools/*.swift
/tests/*
!/tests/model-regression/
!/tests/export-regression/
!/tests/performance/
/tests/model-regression/*
!/tests/model-regression/main.swift
!/tests/model-regression/run.sh
/tests/export-regression/*
!/tests/export-regression/main.swift
!/tests/export-regression/run.sh
/tests/performance/*
!/tests/performance/main.swift
!/tests/performance/run.sh
.DS_Store
