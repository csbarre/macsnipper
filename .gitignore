# Public source allowlist. Private inputs and local artifacts stay untracked.
/*
!/.gitignore
!/README.md
!/mac/
!/tests/
/mac/*
!/mac/Sources/
!/mac/Tools/
!/mac/Info.plist
!/mac/README.md
!/mac/build.sh
!/mac/package.sh
/mac/Sources/*
!/mac/Sources/*.swift
/mac/Tools/*
!/mac/Tools/*.swift
/tests/*
!/tests/model-regression/
!/tests/export-regression/
!/tests/performance/
/tests/model-regression/*
!/tests/model-regression/main.swift
!/tests/model-regression/run.sh
/tests/export-regression/*
!/tests/export-regression/main.swift
!/tests/export-regression/run.sh
/tests/performance/*
!/tests/performance/main.swift
!/tests/performance/run.sh
.DS_Store
